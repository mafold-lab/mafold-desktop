<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- The helper processes (renderer, GPU, plugin). Nothing restricted here:
         they carry no provisioning profile. Passkeys run in the app process
         (entitlements.mac.plist). -->
    <!-- V8 compiles JavaScript at runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Dictation (mafold-web lib/dictate.ts) records from the microphone. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
